# Stage 3 config fragment for Xiaomi Mi 9T / Redmi K20 (davinci)
# SukiSU-Nova features + safe non-overclock debloat & scheduling tweaks.
# SPDX-License-Identifier: GPL-2.0

# Kernel version suffix
CONFIG_LOCALVERSION="-sukisu-nova"

# --- SukiSU-Nova built-in features ---
CONFIG_KPM=y
CONFIG_KSU_FEATURE_ADBROOT=y

# --- Safe hot-path debug debloat (AUDIT, KALLSYMS, FTRACE kept intact) ---
# CONFIG_SLUB_DEBUG is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_QCOM_RTB is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_MSM_TZ_LOG is not set

# --- RCU priority boosting to prevent UI stalls under memory/IO pressure ---
CONFIG_RCU_BOOST=y
